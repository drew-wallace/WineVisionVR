 #include <stdlib.h>
 #include <string.h>
 static struct dock_frame_pump pump;
+static bool messages_enabled;
+static uint64_t messages, timers;
+static void (*report)(const char *, int32_t);
 void dock_frame_start(HMODULE module, void *engine, const struct dock_client_layout *layout, const struct sh_observer *o)
 {
     memset(&pump, 0, sizeof(pump));
+    messages = timers = 0; report = o->event;
+    const char *message_setting = getenv("MADEIRA_STEAM_MESSAGE_PUMP");
+    messages_enabled = !(message_setting && !strcmp(message_setting, "0"));
+    o->event("session-messages-ready", messages_enabled);
     const char *setting = getenv("MADEIRA_STEAM_RUN_FRAME");
