     /* Private engine ABI, independently verified against the exact January
@@ -28,9 +35,27 @@
     pump.frame = (void (*)(void *))(*(void ***)engine)[19];
     o->event("session-frame-ready", 1);
 }
-void dock_frame_tick(void) { (void)dock_frame_poll(&pump); }
+void dock_frame_tick(void)
+{
+    if (messages_enabled) {
+        MSG msg;
+        /* Steam owns hidden windows and timer callbacks in this console host.
+         * SleepEx/APC delivery and Steam_BGetCallback do not dispatch WM_TIMER.
+         * Bound each batch so messages cannot starve auth/launch deadlines. */
+        for (unsigned i = 0; i < 64 && PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE); ++i) {
+            if (msg.message == WM_QUIT) { report("session-messages-quit", 1); break; }
+            ++messages; if (msg.message == WM_TIMER) ++timers;
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+    }
+    (void)dock_frame_poll(&pump);
+}
 void dock_frame_stop(void (*event)(const char *, int32_t))
 {
+    event("session-messages-dispatched", messages <= INT32_MAX ? (int32_t)messages : INT32_MAX);
+    event("session-message-timers", timers <= INT32_MAX ? (int32_t)timers : INT32_MAX);
+    messages_enabled = false; report = NULL;
     if (pump.engine) event("session-frame-ticks", pump.ticks <= INT32_MAX ? (int32_t)pump.ticks : INT32_MAX);
     memset(&pump, 0, sizeof(pump));
 }
