+int dock_sdk_child(const struct sh_observer *o)
+{
+    wchar_t install[32768]; char number[16];
+    DWORD length = GetEnvironmentVariableW(L"MADEIRA_STEAM_HOST_EXPECTED_INSTALL", install, 32768);
+    DWORD count = GetEnvironmentVariableA("MADEIRA_STEAM_HOST_APPID", number, sizeof(number));
+    if (!length || length >= 32768 || !count || count >= sizeof(number)) return 60;
+    char *end = NULL; unsigned long app = strtoul(number, &end, 10);
+    if (!app || !end || *end || app > UINT32_MAX) return 60;
+    o->event("sdk-probe-child-mode", 1);
+    return dock_sdk_probe(install, (uint32_t)app, 0, NULL, o);
+}
+int dock_sdk_spawn(int32_t pipe, const struct sh_api *api, const struct sh_observer *o)
+{
+    wchar_t self[32768], command[32768];
+    DWORD length = GetModuleFileNameW(NULL, self, 32768);
+    if (!length || length >= 32700) return 65;
+    swprintf(command, 32768, L"\"%ls\" --sdk-network-child", self);
+    STARTUPINFOW startup = {0}; PROCESS_INFORMATION process = {0};
+    startup.cb = sizeof(startup); startup.dwFlags = STARTF_USESTDHANDLES;
+    startup.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
+    startup.hStdOutput = GetStdHandle(STD_OUTPUT_HANDLE);
+    startup.hStdError = GetStdHandle(STD_ERROR_HANDLE);
+    if (!CreateProcessW(self, command, NULL, NULL, TRUE, 0, NULL, NULL, &startup, &process)) {
+        o->event("sdk-probe-child-started", 0); return 65;
+    }
+    o->event("sdk-probe-child-started", 1);
+    uint64_t begin = o->now_ms(); DWORD result = 65;
+    while (o->now_ms() - begin < 50000) {
+        DWORD waited = WaitForSingleObject(process.hProcess, 0);
+        if (waited == WAIT_OBJECT_0) { if (!GetExitCodeProcess(process.hProcess, &result)) result = 65; break; }
+        if (waited == WAIT_FAILED) break;
+        dock_frame_tick();
+        for (unsigned batch = 0; batch < 64; ++batch) {
+            struct sh_callback callback = {0};
+            if (!api->get_callback(pipe, &callback)) break;
+            api->free_callback(pipe);
+        }
+        o->sleep_ms(20);
+    }
+    if (result == 65) TerminateProcess(process.hProcess, 65);
+    CloseHandle(process.hThread); CloseHandle(process.hProcess);
+    o->event("sdk-probe-child-result", (int32_t)result);
+    return (int)result;
+}
