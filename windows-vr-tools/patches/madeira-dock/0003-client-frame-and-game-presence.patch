+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright 2026 WineVision VR contributors
+ * Madeira Converter Exception: see LICENSE-EXCEPTION.md */
+#include "frame.h"
+bool dock_frame_poll(struct dock_frame_pump *pump)
+{
+    if (!pump || !pump->engine || !pump->frame) return false;
+    pump->frame(pump->engine);
+    if (pump->ticks < UINT64_MAX) ++pump->ticks;
+    return true;
+}
+#ifdef _WIN64
+#include <stdlib.h>
+#include <string.h>
+static struct dock_frame_pump pump;
+void dock_frame_start(HMODULE module, void *engine, const struct dock_client_layout *layout, const struct sh_observer *o)
+{
+    memset(&pump, 0, sizeof(pump));
+    const char *setting = getenv("MADEIRA_STEAM_RUN_FRAME");
+    if (setting && !strcmp(setting, "0")) { o->event("session-frame-disabled", 1); return; }
+    /* Private engine ABI, independently verified against the exact January
+     * client. The public SteamClient021 has a different slot layout. */
+    if (!layout || strcmp(layout->sha256, "71b391fe9f3e2006cbc81a5c75eef3eb4186012deabfdb2c8b7e8d4850ecf640") ||
+        !dock_method_is((uintptr_t)module, engine, 19, 0x945e30)) {
+        o->event("session-frame-ready", 0); return;
+    }
+    pump.engine = engine;
+    pump.frame = (void (*)(void *))(*(void ***)engine)[19];
+    o->event("session-frame-ready", 1);
+}
+void dock_frame_tick(void) { (void)dock_frame_poll(&pump); }
+void dock_frame_stop(void (*event)(const char *, int32_t))
+{
+    if (pump.engine) event("session-frame-ticks", pump.ticks <= INT32_MAX ? (int32_t)pump.ticks : INT32_MAX);
+    memset(&pump, 0, sizeof(pump));
+}
+#endif
