   template <CommandWithContext<ArgumentEncodingContext> cmd> void EmitOP(cmd &&fn);
+
+  // Resolve readiness on the submission thread after asynchronous PSO work.
+  // A rejected PSO must invalidate an earlier binding and suppress this draw.
+  template <CommandWithContext<ArgumentEncodingContext> cmd>
+  void EmitDraw(cmd &&fn) {
+    EmitOP([fn = std::forward<cmd>(fn)](ArgumentEncodingContext &enc) mutable {
+      if (!enc.currentRenderEncoder()->last_pso)
+        return;
+      fn(enc);
+    });
+  }
