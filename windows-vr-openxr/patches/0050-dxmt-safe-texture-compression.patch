+// Keep the native boundary defensive even when a guest descriptor is malformed.
+static BOOL
+wmt_lossy_texture_eligible(MTLTextureDescriptor *desc, uint32_t request) {
+  if (request != 1 || desc.textureType != MTLTextureType2D ||
+      desc.sampleCount != 1 || desc.arrayLength != 1 || desc.depth != 1 ||
+      desc.storageMode != MTLStorageModePrivate ||
+      !(desc.usage & MTLTextureUsageRenderTarget) ||
+      (desc.usage & (MTLTextureUsageShaderWrite | MTLTextureUsagePixelFormatView)))
+    return NO;
+  switch (desc.pixelFormat) {
+  case MTLPixelFormatRGBA8Unorm:
+  case MTLPixelFormatBGRA8Unorm:
+  case MTLPixelFormatRGBA16Float:
+  case MTLPixelFormatRG11B10Float:
+  case MTLPixelFormatRGB10A2Unorm:
+    return YES;
+  default:
+    return NO;
+  }
+}
