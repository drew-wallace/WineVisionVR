--- /dev/null
+++ b/src/dxmt/dxmt_present_format.hpp
@@ -0,0 +1,14 @@
+#pragma once
+#include "winemetal.h"
+
+namespace dxmt {
+// Explicit comparison for packed 10-bit SDR desktop presentation. The game
+// retains its original render targets; the present shader converts into BGRA8.
+// HDR, linear/wide SDR, other formats and ordinary launches retain their format.
+inline WMTPixelFormat SelectSDRPresentationFormat(
+    WMTPixelFormat format, WMTColorSpace colorspace, bool enabled) {
+  if (enabled && colorspace == WMTColorSpaceSRGB && format == WMTPixelFormatRGB10A2Unorm)
+    return WMTPixelFormatBGRA8Unorm;
+  return format;
+}
+} // namespace dxmt
