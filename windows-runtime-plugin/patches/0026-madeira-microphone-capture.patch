+static int ios_capture_any_started(struct ios_stream *except) {
+    for (int i=0;i<IOS_MAX_STREAMS;++i) {
+        struct ios_stream *s=atomic_load_explicit(&g_capture[i],memory_order_acquire);
+        if (s && s!=except && s->started) return 1;
+    }
+    return 0;
+}
+
+static int ios_capture_attach(struct ios_stream *s) {
+    int slot=-1;
+    pthread_mutex_lock(&g_dev_lock);
+    if (!ios_dev_create_locked(s)) for (int i=0;i<IOS_MAX_STREAMS;++i)
+        if (!atomic_load(&g_capture[i])) { slot=i; atomic_store_explicit(&g_capture[i],s,memory_order_release); break; }
+    pthread_mutex_unlock(&g_dev_lock);
+    return slot<0 ? -1:0;
+}
+
+static int ios_capture_detach(struct ios_stream *s) {
+    pthread_mutex_lock(&g_dev_lock);
+    /* Uninitialize quiesces callbacks before this client can be freed. */
+    OSStatus err=ios_capture_configure_locked(ios_capture_any_started(s),s);
+    pthread_mutex_unlock(&g_dev_lock);
+    if (err) fprintf(stderr,"[ios_capture] detach failed=%d; retaining client memory for safety\n",(int)err);
+    return err;
 }
 
