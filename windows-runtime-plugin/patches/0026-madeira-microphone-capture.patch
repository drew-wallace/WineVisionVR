+/* Control thread, g_dev_lock held. Quiesce both callbacks before changing input
+ * or retiring a capture client. The same RemoteIO instance owns both directions.
+ * On an enable failure restore playback and report the original hardware error. */
+static OSStatus ios_capture_configure_locked(int enabled, struct ios_stream *retire) {
+    if (!g_dev.au) return kAudioUnitErr_Uninitialized;
+    if (g_dev.input_enabled==enabled && !retire) return noErr;
+    int was_running=g_dev.running, previous=g_dev.input_enabled;
+    OSStatus err=noErr;
+    if (was_running && (err=AudioOutputUnitStop(g_dev.au))) return err;
+    g_dev.running=0;
+    if ((err=AudioUnitUninitialize(g_dev.au))) {
+        if (was_running && !AudioOutputUnitStart(g_dev.au)) g_dev.running=1;
+        return err;
+    }
+    if (retire) for (int i=0;i<IOS_MAX_STREAMS;++i)
+        if (atomic_load(&g_capture[i])==retire) atomic_store_explicit(&g_capture[i],NULL,memory_order_release);
+    UInt32 on=enabled;
+    err=AudioUnitSetProperty(g_dev.au,kAudioOutputUnitProperty_EnableIO,kAudioUnitScope_Input,1,&on,sizeof(on));
+    if (!err && enabled) {
+        AudioStreamBasicDescription fmt={0};
+        fmt.mSampleRate=g_dev.rate; fmt.mFormatID=kAudioFormatLinearPCM;
+        fmt.mFormatFlags=kAudioFormatFlagIsFloat|kAudioFormatFlagIsPacked;
+        fmt.mBytesPerPacket=fmt.mBytesPerFrame=sizeof(float);
+        fmt.mFramesPerPacket=fmt.mChannelsPerFrame=1; fmt.mBitsPerChannel=32;
+        err=AudioUnitSetProperty(g_dev.au,kAudioUnitProperty_StreamFormat,kAudioUnitScope_Output,1,&fmt,sizeof(fmt));
+        UInt32 allocate=0;
+        if (!err) err=AudioUnitSetProperty(g_dev.au,kAudioUnitProperty_ShouldAllocateBuffer,kAudioUnitScope_Output,1,&allocate,sizeof(allocate));
+        AURenderCallbackStruct cb={ios_audio_capture_cb,NULL};
+        if (!err) err=AudioUnitSetProperty(g_dev.au,kAudioOutputUnitProperty_SetInputCallback,kAudioUnitScope_Global,1,&cb,sizeof(cb));
+        UInt32 maximum=8192;
+        if (!err) err=AudioUnitSetProperty(g_dev.au,kAudioUnitProperty_MaximumFramesPerSlice,kAudioUnitScope_Global,0,&maximum,sizeof(maximum));
+    }
+    if (!err) err=AudioUnitInitialize(g_dev.au);
+    if (err) {
+        UInt32 restore=previous;
+        OSStatus restored=AudioUnitSetProperty(g_dev.au,kAudioOutputUnitProperty_EnableIO,kAudioUnitScope_Input,1,&restore,sizeof(restore));
+        if (!restored) restored=AudioUnitInitialize(g_dev.au);
+        /* A failed disable must never resume microphone I/O after the last
+         * capture client stopped. Keep the unit stopped and return the error. */
+        if (!restored && was_running && enabled && !AudioOutputUnitStart(g_dev.au)) g_dev.running=1;
+        fprintf(stderr,"[ios_capture] input configuration failed=%d playback restore=%d\n",(int)err,(int)restored);
+        return err;
+    }
+    g_dev.input_enabled=enabled;
+    if (was_running) {
+        err=AudioOutputUnitStart(g_dev.au);
+        if (!err) g_dev.running=1;
+        else if (enabled) {
+            /* Restore the previous playback configuration if enabling input
+             * cannot start. Never restore active input after a failed stop. */
+            (void)AudioUnitUninitialize(g_dev.au);
+            UInt32 restore=previous;
+            OSStatus restored=AudioUnitSetProperty(g_dev.au,kAudioOutputUnitProperty_EnableIO,kAudioUnitScope_Input,1,&restore,sizeof(restore));
+            if (!restored) restored=AudioUnitInitialize(g_dev.au);
+            if (!restored) restored=AudioOutputUnitStart(g_dev.au);
+            if (!restored) { g_dev.running=1; g_dev.input_enabled=previous; }
+            fprintf(stderr,"[ios_capture] start failed=%d playback restore=%d\n",(int)err,(int)restored);
+        }
+    }
+    fprintf(stderr,"[ios_capture] hardware input=%d status=%d rate=%u\n",enabled,(int)err,g_dev.rate);
+    return err;
+}
