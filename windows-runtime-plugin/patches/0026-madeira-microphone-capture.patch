diff --git a/build/ntdll-unix/ios_capture_ring.h b/build/ntdll-unix/ios_capture_ring.h
new file mode 100644
--- /dev/null
+++ b/build/ntdll-unix/ios_capture_ring.h
@@ -0,0 +1,135 @@
+#ifndef WVR_IOS_CAPTURE_RING_H
+#define WVR_IOS_CAPTURE_RING_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdatomic.h>
+#include <math.h>
+
+/* Single hardware producer, one WASAPI consumer per stream. The producer never
+ * overwrites unread or outstanding packets. No allocation/locks in push(). */
+struct wvr_capture_ring {
+    unsigned char *data;
+    uint64_t *positions, *timestamps;
+    uint32_t capacity, rate, channels, bits, frame_bytes;
+    int is_float;
+    _Atomic uint64_t written, consumed, clock;
+    _Atomic unsigned discontinuity;
+    uint32_t pending, pending_flags;
+    uint64_t pending_position, next_position;
+    double phase;
+};
+
+static int wvr_capture_format(uint32_t rate, uint32_t channels, uint32_t bits, int is_float) {
+    return rate >= 8000 && rate <= 192000 && (channels == 1 || channels == 2) &&
+        ((is_float && bits == 32) || (!is_float && (bits == 16 || bits == 32)));
+}
+
+static int wvr_capture_init(struct wvr_capture_ring *r, unsigned char *data,
+                            uint32_t capacity, uint32_t rate, uint32_t channels,
+                            uint32_t bits, int is_float) {
+    if (!r || !data || !capacity || !wvr_capture_format(rate,channels,bits,is_float)) return -1;
+    memset(r,0,sizeof(*r));
+    r->positions = calloc(capacity,sizeof(uint64_t));
+    r->timestamps = calloc(capacity,sizeof(uint64_t));
+    if (!r->positions || !r->timestamps) {
+        free(r->positions); free(r->timestamps); memset(r,0,sizeof(*r)); return -1;
+    }
+    r->data=data; r->capacity=capacity; r->rate=rate; r->channels=channels;
+    r->bits=bits; r->is_float=is_float; r->frame_bytes=channels*(bits/8);
+    atomic_init(&r->written,0); atomic_init(&r->consumed,0); atomic_init(&r->clock,0);
+    atomic_init(&r->discontinuity,0);
+    return 0;
+}
+
+static void wvr_capture_destroy(struct wvr_capture_ring *r) {
+    free(r->positions); free(r->timestamps); memset(r,0,sizeof(*r));
+}
+
+/* Only call with capture stopped and the hardware callback quiesced. */
+static void wvr_capture_reset(struct wvr_capture_ring *r) {
+    atomic_store(&r->written,0); atomic_store(&r->consumed,0); atomic_store(&r->clock,0);
+    atomic_store(&r->discontinuity,0); r->pending=0; r->pending_flags=0;
+    r->pending_position=r->next_position=0; r->phase=0;
+}
+
+static uint32_t wvr_capture_available(const struct wvr_capture_ring *r) {
+    uint64_t rd=atomic_load_explicit(&r->consumed,memory_order_acquire);
+    uint64_t wr=atomic_load_explicit(&r->written,memory_order_acquire);
+    return (uint32_t)(wr>rd ? wr-rd : 0);
+}
+
+static uint32_t wvr_capture_packet_frames(const struct wvr_capture_ring *r) {
+    uint32_t n=wvr_capture_available(r), period=r->rate/100;
+    return n<period ? n : period;
+}
+
+static void wvr_capture_push(struct wvr_capture_ring *r, const float *mono,
+                             uint32_t frames, uint32_t input_rate, uint64_t qpc100ns) {
+    if (!mono || !frames || !input_rate) return;
+    uint64_t wr=atomic_load_explicit(&r->written,memory_order_relaxed);
+    uint64_t clock=atomic_load_explicit(&r->clock,memory_order_relaxed);
+    double step=(double)input_rate/r->rate;
+    for (; r->phase<frames; r->phase+=step, ++clock) {
+        uint64_t rd=atomic_load_explicit(&r->consumed,memory_order_acquire);
+        if (wr-rd>=r->capacity) {
+            atomic_store_explicit(&r->discontinuity,1,memory_order_release); continue;
+        }
+        uint32_t i=(uint32_t)r->phase;
+        float a=mono[i], b=mono[i+1<frames ? i+1:i];
+        double fraction=r->phase-i;
+        double value=fraction>0 ? a+(b-a)*fraction : a;
+        if (!isfinite(value)) value=0;
+        if (value>1) value=1; if (value< -1) value= -1;
+        unsigned char *dst=r->data+(wr%r->capacity)*r->frame_bytes;
+        for (uint32_t c=0;c<r->channels;++c) {
+            if (r->is_float) { float v=(float)value; memcpy(dst+c*4,&v,4); }
+            else if (r->bits==16) {
+                int16_t v=value<= -1 ? INT16_MIN : (int16_t)(value*INT16_MAX);
+                memcpy(dst+c*2,&v,2);
+            } else {
+                int32_t v=value<= -1 ? INT32_MIN : (int32_t)(value*INT32_MAX);
+                memcpy(dst+c*4,&v,4);
+            }
+        }
+        r->positions[wr%r->capacity]=clock;
+        r->timestamps[wr%r->capacity]=qpc100ns+(uint64_t)(r->phase*10000000.0/input_rate);
+        ++wr;
+    }
+    r->phase-=frames;
+    atomic_store_explicit(&r->clock,clock,memory_order_release);
+    atomic_store_explicit(&r->written,wr,memory_order_release);
+}
+
+/* -1: outstanding packet, 0: no captured data, 1: valid packet in scratch. */
+static int wvr_capture_get(struct wvr_capture_ring *r, unsigned char *scratch,
+                            uint32_t *frames, uint32_t *flags,
+                            uint64_t *position, uint64_t *qpc100ns) {
+    *frames=0; *flags=0;
+    if (r->pending) return -1;
+    uint32_t count=wvr_capture_packet_frames(r);
+    if (!count) return 0;
+    uint64_t rd=atomic_load_explicit(&r->consumed,memory_order_relaxed);
+    uint32_t index=(uint32_t)(rd%r->capacity), first=r->capacity-index;
+    if (first>count) first=count;
+    memcpy(scratch,r->data+(size_t)index*r->frame_bytes,(size_t)first*r->frame_bytes);
+    if (first<count) memcpy(scratch+(size_t)first*r->frame_bytes,r->data,(size_t)(count-first)*r->frame_bytes);
+    *frames=count; *position=r->positions[index]; *qpc100ns=r->timestamps[index];
+    *flags=(atomic_exchange_explicit(&r->discontinuity,0,memory_order_acq_rel) ||
+        *position!=r->next_position) ? 1:0;
+    r->pending_position=*position;
+    r->pending=count; r->pending_flags=*flags;
+    return 1;
+}
+
+static int wvr_capture_release(struct wvr_capture_ring *r, uint32_t done) {
+    if (!r->pending || (done && done!=r->pending)) return -1;
+    if (done) {
+        atomic_fetch_add_explicit(&r->consumed,done,memory_order_release);
+        r->next_position=r->pending_position+done;
+    }
+    else if (r->pending_flags) atomic_store_explicit(&r->discontinuity,1,memory_order_release);
+    r->pending=0;
+    return 0;
+}
+#endif
