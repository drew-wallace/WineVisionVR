@@ -15477,6 +15479,22 @@
         }
         SERVER_END_REQ;
 
+#ifdef WINE_IOS
+        /* Pseudo-processes share the host view tree, but wineserver records
+         * SEC_RESERVE mappings per Windows process. A sibling's physical view
+         * therefore has no mapping in this caller's server process. Query its
+         * existing local protections without inventing commit state or changing
+         * any page permissions. Never return a successful zero-length region.
+         * virtual_mutex keeps the local view and its vprot bytes stable. */
+        if (query_status == STATUS_NOT_MAPPED_VIEW && offset < view->size)
+        {
+            static unsigned int reports;
+            size = min( view->size - offset, max_size );
+            if (__sync_add_and_fetch( &reports, 1 ) <= 16)
+                dprintf( 2, "[shared-view-query] local range base=%p view=%p offset=%#lx size=%#lx status=%08x\n",
+                         base, view->base, (unsigned long)offset, (unsigned long)size, query_status );
+        }
+#endif
         if (!size || !(vprot_mask & ~VPROT_COMMITTED)) return size;
     }
     else size = min( view->size - offset, max_size );
