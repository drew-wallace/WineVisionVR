 static constexpr size_t JIT_POOL_SIZE = 640ULL * 1024 * 1024;
+
+// A game-scoped host setting may request extra capacity. Keep one validated
+// size for debugger allocation, RW remapping and the exported RX/RW bounds.
+static size_t jit_pool_size_for_override(const char *value) {
+    if (!value || !*value) return JIT_POOL_SIZE;
+    unsigned mib = 0;
+    for (const char *p = value; *p; ++p) {
+        if (*p < '0' || *p > '9' || mib > 1024) return JIT_POOL_SIZE;
+        mib = mib * 10 + static_cast<unsigned>(*p - '0');
+    }
+    if (mib < 640 || mib > 1024 || mib % 64 != 0) return JIT_POOL_SIZE;
+    return static_cast<size_t>(mib) * 1024 * 1024;
+}
