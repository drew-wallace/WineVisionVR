diff --git a/OpenOVR/Misc/WVRProjectionLayers.h b/OpenOVR/Misc/WVRProjectionLayers.h
new file mode 100644
--- /dev/null
+++ b/OpenOVR/Misc/WVRProjectionLayers.h
@@ -0,0 +1,14 @@
+#pragma once
+
+#include <cstring>
+#include <openxr/openxr.h>
+
+// WineVision currently accepts scene projection layers only. Optional OpenVR
+// loading overlays must fail before resource upload or OpenXR frame mutation.
+// Failed property queries retain upstream handling for unknown runtimes.
+inline bool WVRIsProjectionOnlyRuntime(XrInstance instance)
+{
+    XrInstanceProperties runtime{ XR_TYPE_INSTANCE_PROPERTIES };
+    return XR_SUCCEEDED(xrGetInstanceProperties(instance, &runtime)) &&
+        std::strcmp(runtime.runtimeName, "WineVision VR") == 0;
+}
