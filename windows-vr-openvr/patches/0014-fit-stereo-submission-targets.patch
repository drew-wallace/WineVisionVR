diff --git a/OpenOVR/Compositor/WVRTextureExtent.h b/OpenOVR/Compositor/WVRTextureExtent.h
new file mode 100644
--- /dev/null
+++ b/OpenOVR/Compositor/WVRTextureExtent.h
@@ -0,0 +1,17 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+// Keep the full source UV range; only the output allocation/viewport shrinks.
+// This runtime can upscale smaller submissions but rejects oversized images.
+inline bool WVRFitTextureExtent(uint32_t& width, uint32_t& height,
+                                uint32_t maximumWidth, uint32_t maximumHeight)
+{
+    if (!width || !height || !maximumWidth || !maximumHeight) return false;
+    const uint32_t fittedWidth = std::min(width, maximumWidth);
+    const uint32_t fittedHeight = std::min(height, maximumHeight);
+    const bool resample = fittedWidth != width || fittedHeight != height;
+    width = fittedWidth;
+    height = fittedHeight;
+    return resample;
+}
